        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos seleccionados compatibles pueden activarse automáticamente cuando el modelo de chat necesite ayuda con imágenes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Compatibele geselecteerde modellen kunnen automatisch worden aangeroepen wanneer het chatmodel hulp nodig heeft bij afbeeldingen.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompatible ausgewählte Modelle können automatisch aufgerufen werden, wenn das Chatmodell Hilfe bei Bildern benötigt."
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "I modelli selezionati compatibili possono essere chiamati automaticamente quando il modello di chat ha bisogno di aiuto con le immagini.",
