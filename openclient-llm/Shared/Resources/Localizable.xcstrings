        }
      },
      "comment" : "A description of the costs of using an additional model."
    },
    "Turn off automatic detection to choose this model's capabilities. Manual choices override detection for this server. Open chats keep their loaded capabilities." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Turn off automatic detection to choose this model's capabilities. Manual choices override detection for this server. Open chats keep their loaded capabilities.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Désactivez la détection automatique pour choisir les capacités de ce modèle. Les choix manuels prennent le pas sur la détection pour ce serveur. Les discussions ouvertes conservent leurs capacités chargées.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Deaktiviere die automatische Erkennung, um die Fähigkeiten dieses Modells auszuwählen. Manuelle Auswahlen überschreiben die Erkennung für diesen Server. Geöffnete Chats behalten ihre geladenen Fähigkeiten.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモデルの機能を選択するには、自動検出をオフにしてください。このサーバーでは手動選択が検出より優先されます。開いているチャットでは、読み込まれた機能が維持されます。"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Desative a deteção automática para escolher as capacidades deste modelo. As escolhas manuais substituem a deteção neste servidor. Os chats abertos mantêm as capacidades carregadas.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stäng av automatisk identifiering för att välja den här modellens funktioner. Manuella val åsidosätter identifieringen för den här servern. Öppna chattar behåller sina inlästa funktioner."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποιήστε τον αυτόματο εντοπισμό για να επιλέξετε τις δυνατότητες αυτού του μοντέλου. Οι μη αυτόματες επιλογές υπερισχύουν του εντοπισμού για αυτόν τον διακομιστή. Οι ανοιχτές συνομιλίες διατηρούν τις φορτωμένες δυνατότητές τους."
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Disattiva il rilevamento automatico per scegliere le capacità di questo modello. Le scelte manuali hanno la precedenza sul rilevamento per questo server. Le chat aperte mantengono le capacità caricate.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva la detección automática para elegir las capacidades de este modelo. Las selecciones manuales anulan la detección para este servidor. Los chats abiertos conservan sus capacidades cargadas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Schakel automatische detectie uit om de mogelijkheden van dit model te kiezen. Handmatige keuzes overschrijven de detectie voor deze server. Geopende chats behouden hun geladen mogelijkheden.",
            "state" : "translated"
          }
        }
      }
    },
