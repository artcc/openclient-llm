      "shouldTranslate" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld."
          }
        }
      }
    },
    "%lld of %lld MCP tools enabled. Availability and permissions can also be managed from the chat input bar." : {
      "comment" : "A summary of the number of enabled and total MCP tools.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "%1$lld of %2$lld MCP tools enabled. Availability and permissions can also be managed from the chat input bar.",
            "state" : "new"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld van %2$lld MCP-tools ingeschakeld. Beschikbaarheid en machtigingen kunnen ook worden beheerd via de invoerbalk van de chat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "%1$lld av %2$lld MCP-verktyg aktiverade. Tillgänglighet och behörigheter kan också hanteras från chattens inmatningsfält.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld herramientas de MCP habilitadas. La disponibilidad y los permisos también se pueden gestionar desde la barra de entrada del chat."
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "%1$lld di %2$lld strumenti MCP abilitati. La disponibilità e le autorizzazioni possono essere gestite anche dalla barra di input della chat.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld\/%2$lld個のMCPツールが有効です。利用可能状況と権限は、チャット入力バーからも管理できます。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld sur %2$lld outils MCP activés. La disponibilité et les autorisations peuvent également être gérées depuis la barre de saisie du chat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld ferramentas MCP ativadas. A disponibilidade e as permissões também podem ser geridas a partir da barra de entrada do chat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld MCP-Tools aktiviert. Verfügbarkeit und Berechtigungen können auch über die Chat-Eingabeleiste verwaltet werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld από %2$lld εργαλεία MCP ενεργοποιημένα. Η διαθεσιμότητα και τα δικαιώματα μπορούν επίσης να διαχειριστούν από τη γραμμή εισαγωγής συνομιλίας."
          }
        }
      }
    },
    "Image generation or editing is no longer available. Start a new turn with the current configuration." : {
      "comment" : "Text displayed in a notification when the image generation or editing is no longer available.",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "value" : "Η δημιουργία ή επεξεργασία εικόνων δεν είναι πλέον διαθέσιμη. Ξεκινήστε νέο γύρο με την τρέχουσα διαμόρφωση.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afbeelding genereren of bewerken is niet langer beschikbaar. Start een nieuwe beurt met de huidige configuratie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La generazione o la modifica delle immagini non è più disponibile. Avvia un nuovo turno con la configurazione attuale."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La generación o edición de imágenes ya no está disponible. Inicia un nuevo turno con la configuración actual."
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Bildgenerering eller bildredigering är inte längre tillgänglig. Starta en ny omgång med den aktuella konfigurationen.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像の生成または編集は利用できなくなりました。現在の設定で新しいターンを開始してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La génération ou la modification d’images n’est plus disponible. Commencez un nouveau tour avec la configuration actuelle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A geração ou edição de imagens já não está disponível. Inicie um novo turno com a configuração atual."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildgenerierung oder -bearbeitung ist nicht mehr verfügbar. Starte einen neuen Durchgang mit der aktuellen Konfiguration."
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Image generation or editing is no longer available. Start a new turn with the current configuration.",
            "state" : "translated"
          }
        }
      }
    },
