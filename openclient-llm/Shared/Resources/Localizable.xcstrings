    "Compatible selected models may be called automatically when the chat model needs help with images." : {
      "comment" : "A description of how image and vision models can be used with the chat model.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Compatible selected models may be called automatically when the chat model needs help with images.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "互換性のある選択済みモデルは、チャットモデルが画像の処理に支援を必要とすると自動的に呼び出されることがあります。",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Kompatibla valda modeller kan anropas automatiskt när chattmodellen behöver hjälp med bilder.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Los modelos seleccionados compatibles pueden activarse automáticamente cuando el modelo de chat necesite ayuda con imágenes.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Os modelos selecionados compatíveis podem ser chamados automaticamente quando o modelo de chat precisar de ajuda com imagens.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "I modelli selezionati compatibili possono essere chiamati automaticamente quando il modello di chat ha bisogno di aiuto con le immagini.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Certains modèles sélectionnés compatibles peuvent être appelés automatiquement lorsque le modèle de chat a besoin d’aide avec les images.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Kompatible ausgewählte Modelle können automatisch aufgerufen werden, wenn das Chatmodell Hilfe bei Bildern benötigt.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Compatibele geselecteerde modellen kunnen automatisch worden aangeroepen wanneer het chatmodel hulp nodig heeft bij afbeeldingen.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα συμβατά επιλεγμένα μοντέλα μπορεί να καλούνται αυτόματα όταν το μοντέλο συνομιλίας χρειάζεται βοήθεια με εικόνες."
          }
        }
      }
    },
    "MCP tool settings changed. Affected allow decisions were cleared. Deny those calls or close this review." : {
      "comment" : "Error message displayed when the MCP tool settings have changed.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "MCP tool settings changed. Affected allow decisions were cleared. Deny those calls or close this review.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "MCPツールの設定が変更されました。影響を受ける許可の判断はクリアされました。これらの呼び出しを拒否するか、このレビューを閉じてください。",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "MCP-verktygsinställningarna har ändrats. Berörda tillåtelsebeslut har rensats. Neka dessa anrop eller stäng den här granskningen.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "La configuración de la herramienta MCP ha cambiado. Se borraron las decisiones de autorización afectadas. Deniega esas llamadas o cierra esta revisión.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "As definições da ferramenta MCP foram alteradas. As decisões de permissão afetadas foram eliminadas. Negue essas chamadas ou feche esta revisão.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Le impostazioni dello strumento MCP sono cambiate. Le decisioni di autorizzazione interessate sono state cancellate. Nega queste chiamate o chiudi questa revisione.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Les réglages de l’outil MCP ont changé. Les décisions d’autorisation concernées ont été effacées. Refusez ces appels ou fermez cet examen.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die MCP-Tool-Einstellungen wurden geändert. Betroffene Zulassungsentscheidungen wurden gelöscht. Lehnen Sie diese Aufrufe ab oder schließen Sie diese Überprüfung."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "De MCP-toolinstellingen zijn gewijzigd. De betreffende toestemmingsbeslissingen zijn gewist. Weiger die aanroepen of sluit deze beoordeling.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Οι ρυθμίσεις του εργαλείου MCP άλλαξαν. Οι επηρεαζόμενες αποφάσεις έγκρισης διαγράφηκαν. Απορρίψτε αυτές τις κλήσεις ή κλείστε αυτήν την αξιολόγηση.",
            "state" : "translated"
          }
        }
      }
    },
