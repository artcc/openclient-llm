          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δειγματοληψία πυρήνα. Οι χαμηλότερες τιμές κάνουν την έξοδο πιο εστιασμένη."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
