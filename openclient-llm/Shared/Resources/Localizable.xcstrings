    "These tools are unavailable until this server refreshes successfully." : {
      "comment" : "A warning message that appears when the MCP server is unavailable.",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "value" : "Αυτά τα εργαλεία δεν είναι διαθέσιμα μέχρι να ολοκληρωθεί επιτυχώς η ανανέωση αυτού του διακομιστή.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "このサーバーの更新が正常に完了するまで、これらのツールは利用できません。",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Ces outils sont indisponibles jusqu’à l’actualisation réussie de ce serveur.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Diese Tools sind nicht verfügbar, bis dieser Server erfolgreich aktualisiert wurde.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Deze tools zijn niet beschikbaar totdat deze server succesvol is vernieuwd.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Dessa verktyg är otillgängliga tills servern har uppdaterats.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Estas herramientas no estarán disponibles hasta que este servidor se actualice correctamente.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Questi strumenti non sono disponibili finché il server non viene aggiornato correttamente.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "These tools are unavailable until this server refreshes successfully.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Estas ferramentas não estão disponíveis até este servidor ser atualizado com êxito.",
            "state" : "translated"
          }
        }
      }
    },
    "None disables delegation for that role without changing the chat model's native capabilities." : {
      "comment" : "A description of the limitations of using an LLM's delegation.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "value" : "なしにすると、その役割の委任が無効になりますが、チャットモデル本来の能力は変わりません。",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Το «Κανένα» απενεργοποιεί την ανάθεση για αυτόν τον ρόλο χωρίς να αλλάζει τις εγγενείς δυνατότητες του μοντέλου συνομιλίας.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "„Keine“ deaktiviert die Delegierung für diese Rolle, ohne die nativen Fähigkeiten des Chatmodells zu ändern.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Aucun désactive la délégation pour ce rôle sans modifier les capacités natives du modèle de chat.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Geen schakelt delegering voor die rol uit zonder de ingebouwde mogelijkheden van het chatmodel te wijzigen.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Ninguno desactiva la delegación para ese rol sin cambiar las capacidades nativas del modelo de chat.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Ingen inaktiverar delegering för den rollen utan att ändra chattmodellens inbyggda funktioner.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Nessuno disabilita la delega per quel ruolo senza modificare le capacità native del modello di chat.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "None disables delegation for that role without changing the chat model's native capabilities.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Nenhum desativa a delegação para essa função sem alterar as capacidades nativas do modelo de conversação.",
            "state" : "translated"
          }
        }
      }
    },
