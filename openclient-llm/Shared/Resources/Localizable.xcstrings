    "An attachment could not be loaded or prepared. Please try again." : {
      "comment" : "Error message displayed when an attachment fails to load or prepare.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger ou de préparer une pièce jointe. Veuillez réessayer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível carregar ou preparar um anexo. Tente novamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een bijlage kon niet worden geladen of voorbereid. Probeer het opnieuw."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile caricare o preparare l’allegato. Riprova."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An attachment could not be loaded or prepared. Please try again."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Anhang konnte nicht geladen oder vorbereitet werden. Bitte versuche es erneut."
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Det gick inte att läsa in eller förbereda bilagan. Försök igen.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "添付ファイルを読み込むか準備できませんでした。もう一度お試しください。",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η φόρτωση ή η προετοιμασία του συνημμένου. Δοκιμάστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "No se pudo cargar ni preparar el archivo adjunto. Inténtalo de nuevo.",
            "state" : "translated"
          }
        }
      }
    },
    "Your local data will be merged into the current iCloud account. Cancel to keep iCloud Sync disabled." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα τοπικά δεδομένα σας θα συγχωνευτούν με τον τρέχοντα λογαριασμό iCloud. Πατήστε «Ακύρωση» για να διατηρήσετε τον συγχρονισμό iCloud απενεργοποιημένο."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine lokalen Daten werden mit dem aktuellen iCloud-Account zusammengeführt. Tippe auf „Abbrechen“, um die iCloud-Synchronisierung deaktiviert zu lassen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati locali verranno uniti all’account iCloud attuale. Tocca Annulla per mantenere disabilitata la sincronizzazione iCloud."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os seus dados locais serão fundidos com a conta iCloud atual. Cancele para manter a sincronização com o iCloud desativada."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos locales se fusionarán con la cuenta de iCloud actual. Pulsa «Cancelar» para mantener desactivada la sincronización con iCloud."
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Dina lokala data kommer att slås samman med det aktuella iCloud-kontot. Avbryt för att fortsätta ha iCloud-synkronisering inaktiverad.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルデータが現在のiCloudアカウントに統合されます。iCloud同期を無効のままにするには「キャンセル」を選択してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Vos données locales seront fusionnées avec le compte iCloud actuel. Touchez Annuler pour laisser la synchronisation iCloud désactivée.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je lokale gegevens worden samengevoegd met de huidige iCloud-account. Annuleer om iCloud-synchronisatie uitgeschakeld te houden."
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Your local data will be merged into the current iCloud account. Cancel to keep iCloud Sync disabled.",
            "state" : "translated"
          }
        }
      }
    },
