    "These additional requests may incur costs, depending on your provider." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "value" : "Queste richieste aggiuntive potrebbero comportare dei costi, a seconda del tuo provider.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Deze aanvullende verzoeken kunnen, afhankelijk van uw provider, kosten met zich meebrengen.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτά τα πρόσθετα αιτήματα ενδέχεται να επιφέρουν χρεώσεις, ανάλογα με τον πάροχό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These additional requests may incur costs, depending on your provider."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese zusätzlichen Anfragen können je nach Anbieter Kosten anfallen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes pedidos adicionais podem ter custos, dependendo do seu fornecedor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "これらの追加リクエストには、ご利用のプロバイダーによっては料金が発生する場合があります。",
