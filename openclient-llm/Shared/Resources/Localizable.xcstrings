    "Asks your selected vision model to analyze attached images when the chat model cannot see them." : {
      "comment" : "Description of the image analysis feature.",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "value" : "Ζητά από το επιλεγμένο μοντέλο όρασης να αναλύσει τις επισυναπτόμενες εικόνες όταν το μοντέλο συνομιλίας δεν μπορεί να τις δει.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "チャットモデルが画像を認識できない場合に、選択したビジョンモデルに添付画像の分析を依頼します。",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Demande à votre modèle de vision sélectionné d’analyser les images jointes lorsque le modèle de chat ne peut pas les voir.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Fordert Ihr ausgewähltes Vision-Modell auf, angehängte Bilder zu analysieren, wenn das Chat-Modell sie nicht sehen kann.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Vraagt je geselecteerde visiemodel om bijgevoegde afbeeldingen te analyseren wanneer het chatmodel ze niet kan zien.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Solicita a tu modelo de visión seleccionado que analice las imágenes adjuntas cuando el modelo de chat no pueda verlas.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Ber din valda synmodell att analysera bifogade bilder när chattmodellen inte kan se dem.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Chiede al modello di visione selezionato di analizzare le immagini allegate quando il modello di chat non può visualizzarle.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Asks your selected vision model to analyze attached images when the chat model cannot see them.",
            "state" : "translated"
          }
        },
