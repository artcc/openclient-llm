          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Die neueste Nachricht und ihre Anhänge überschreiten dieses Kontextfenster. Erhöhen Sie das Kontextfenster oder kürzen Sie die Nachricht.",
