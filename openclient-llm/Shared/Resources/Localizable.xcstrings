      },
      "comment" : "A description of a feature that allows the model to connect to external tools."
    },
    "Only one image generation request is allowed per turn. Do not retry in this turn." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "value" : "Une seule demande de génération d’image est autorisée par tour. Ne réessayez pas au cours de ce tour.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Só é permitido um pedido de geração de imagem por turno. Não tente novamente neste turno.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast en bildgenereringsbegäran tillåts per tur. Försök inte igen under denna tur."
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Only one image generation request is allowed per turn. Do not retry in this turn.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se permite una solicitud de generación de imágenes por turno. No vuelvas a intentarlo en este turno."
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Pro Durchgang ist nur eine Bildgenerierungsanfrage zulässig. Wiederhole sie in diesem Durchgang nicht.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Per beurt is slechts één verzoek voor het genereren van afbeeldingen toegestaan. Probeer het deze beurt niet opnieuw.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "È consentita una sola richiesta di generazione di immagini per turno. Non riprovare in questo turno.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Επιτρέπεται μόνο ένα αίτημα δημιουργίας εικόνας ανά γύρο. Μην επαναλάβετε την προσπάθεια σε αυτόν τον γύρο.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1ターンにつき、画像生成リクエストは1件のみ許可されています。このターンでは再試行しないでください。"
          }
        }
      }
    },
