    "Bring your server. Connect to LiteLLM, Ollama, LM Studio, or any OpenAI-compatible server." : {
      "comment" : "A description of the benefits of using open-source LLM servers.",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "value" : "Gebruik je eigen server. Maak verbinding met LiteLLM, Ollama, LM Studio of een andere OpenAI-compatibele server.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Anslut din server. Anslut till LiteLLM, Ollama, LM Studio eller valfri OpenAI-kompatibel server.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Usa tu propio servidor. Conéctate a LiteLLM, Ollama, LM Studio o cualquier servidor compatible con OpenAI.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Utilize o seu servidor. Ligue-se ao LiteLLM, Ollama, LM Studio ou a qualquer servidor compatível com a OpenAI.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Bring your server. Connect to LiteLLM, Ollama, LM Studio, or any OpenAI-compatible server.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Bringe deinen Server mit. Verbinde dich mit LiteLLM, Ollama, LM Studio oder jedem OpenAI-kompatiblen Server.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Usa il tuo server. Collegati a LiteLLM, Ollama, LM Studio o a qualsiasi server compatibile con OpenAI.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "サーバーを持ち込んでください。LiteLLM、Ollama、LM Studio、またはOpenAI互換サーバーに接続できます。",
            "state" : "translated"
          }
        },
