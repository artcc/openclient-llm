    "Sent with requests to your configured server. Tap Done, then Save in Server to save changes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "value" : "Envoyé avec les requêtes à votre serveur configuré. Touchez Terminé, puis Enregistrer dans Serveur pour enregistrer les modifications.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviato con richieste al server configurato. Tocca Fine, quindi Salva nel server per salvare le modifiche."
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Sent with requests to your configured server. Tap Done, then Save in Server to save changes.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skickat med förfrågningar till din konfigurerade server. Tryck på Klar och sedan på Spara i Server för att spara ändringarna."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Enviado com pedidos para o servidor configurado. Toque em Concluído e, em seguida, em Guardar no Servidor para guardar as alterações.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviado con solicitudes a tu servidor configurado. Toca Listo y, después, Guardar en Servidor para guardar los cambios."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzonden met aanvragen naar je geconfigureerde server. Tik op Gereed en vervolgens op Bewaar in Server om de wijzigingen op te slaan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Anfragen an deinen konfigurierten Server gesendet. Tippe auf „Fertig“ und anschließend auf „In Server speichern“, um die Änderungen zu sichern."
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "設定したサーバーにリクエストとともに送信されました。「完了」をタップしてから、「サーバー」で「保存」をタップして変更を保存してください。",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Αποστάλθηκε μαζί με τα αιτήματα στον διαμορφωμένο διακομιστή σας. Πατήστε «Τέλος» και, στη συνέχεια, «Αποθήκευση στον διακομιστή» για να αποθηκεύσετε τις αλλαγές.",
            "state" : "translated"
          }
        }
      }
    },
    "%lld of %lld MCP tools enabled. Availability and permissions can also be managed from the chat input bar." : {
      "comment" : "A summary of the number of enabled and total MCP tools.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "value" : "%1$lld de %2$lld herramientas de MCP habilitadas. La disponibilidad y los permisos también se pueden gestionar desde la barra de entrada del chat.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "%1$lld sur %2$lld outils MCP activés. La disponibilité et les autorisations peuvent également être gérées depuis la barre de saisie du chat.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
