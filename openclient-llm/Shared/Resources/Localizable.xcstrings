    "Use the message actions button to edit, regenerate, branch, or save it as a favourite." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε το κουμπί ενεργειών μηνύματος για να το επεξεργαστείτε, να το αναδημιουργήσετε, να δημιουργήσετε διακλάδωση ή να το αποθηκεύσετε ως αγαπημένο."
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Verwende die Nachrichtentaste, um sie zu bearbeiten, neu zu generieren, einen Zweig zu erstellen oder als Favorit zu speichern.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilize o botão de ações da mensagem para a editar, gerar novamente, criar uma ramificação ou guardá-la como favorita."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de knop voor berichtacties om het bericht te bewerken, opnieuw te genereren, een vertakking te maken of het als favoriet op te slaan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "メッセージのアクションボタンを使って、編集、再生成、分岐、またはお気に入りへの保存を行えます。",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd knappen för meddelandeåtgärder för att redigera, generera om, skapa en förgrening eller spara det som en favorit."
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Usa il pulsante delle azioni del messaggio per modificarlo, rigenerarlo, creare un ramo o salvarlo tra i preferiti.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the message actions button to edit, regenerate, branch, or save it as a favourite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le bouton d’actions du message pour le modifier, le régénérer, créer une branche ou l’enregistrer dans vos favoris."
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Usa el botón de acciones del mensaje para editarlo, regenerarlo, crear una ramificación o guardarlo como favorito.",
            "state" : "translated"
          }
        }
      },
      "comment" : "A tip that explains how to use the message actions button."
    },
