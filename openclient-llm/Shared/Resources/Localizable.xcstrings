    "This model advertises vision, but its mode does not support automatic vision requests." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "value" : "Αυτό το μοντέλο διαφημίζει υποστήριξη όρασης, αλλά η λειτουργία του δεν υποστηρίζει αυτόματα αιτήματα όρασης.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "このモデルはビジョン対応をうたっていますが、そのモードでは自動ビジョンリクエストに対応していません。",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Dieses Modell wirbt mit Bildverarbeitung, aber sein Modus unterstützt keine automatischen Bildverarbeitungsanfragen.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Ce modèle annonce la prise en charge de la vision, mais son mode ne prend pas en charge les requêtes de vision automatiques.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Den här modellen marknadsför bildförståelse, men dess läge stöder inte automatiska bildförfrågningar.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Este modelo anuncia compatibilidad con visión, pero su modo no admite solicitudes automáticas de visión.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Dit model adverteert met beeldverwerking, maar de modus ondersteunt geen automatische beeldverzoeken.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Questo modello dichiara di supportare la visione, ma la sua modalità non supporta le richieste automatiche di visione.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "This model advertises vision, but its mode does not support automatic vision requests.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Este modelo anuncia suporte para visão, mas o seu modo não suporta pedidos automáticos de visão.",
            "state" : "translated"
          }
        }
      }
    },
