          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集では視覚機能を備えた専用の画像モデルを使用し、1回のターンにつき会話内の画像を1枚編集します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
