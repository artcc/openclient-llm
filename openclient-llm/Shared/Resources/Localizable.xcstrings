    "None disables delegation for that role without changing the chat model's native capabilities." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "value" : "Ninguno desactiva la delegación para ese rol sin cambiar las capacidades nativas del modelo de chat.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Keine“ deaktiviert die Delegierung für diese Rolle, ohne die nativen Fähigkeiten des Chatmodells zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None disables delegation for that role without changing the chat model's native capabilities."
