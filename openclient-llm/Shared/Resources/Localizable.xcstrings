          "stringUnit" : {
            "value" : "La generazione di immagini nella chat supporta attualmente solo prompt testuali.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Bildgenerering i chatten stöder för närvarande endast textbeskrivningar.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Die Chat-Bildgenerierung unterstützt derzeit nur Texteingaben.",
