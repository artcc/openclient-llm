    "Image generation failed. The request cannot be retried in this turn." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "value" : "Η δημιουργία εικόνας απέτυχε. Το αίτημα δεν μπορεί να επαναληφθεί σε αυτήν τη σειρά.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "画像の生成に失敗しました。このターンではリクエストを再試行できません。",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Échec de la génération de l’image. La demande ne peut pas être réessayée lors de cette tentative.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Die Bildgenerierung ist fehlgeschlagen. Die Anfrage kann in diesem Durchgang nicht erneut versucht werden.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
