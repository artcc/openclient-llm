    "Finish setup to save your server settings and start your first conversation." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Finish setup to save your server settings and start your first conversation.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ολοκληρώστε τη ρύθμιση για να αποθηκεύσετε τις ρυθμίσεις του διακομιστή σας και να ξεκινήσετε την πρώτη σας συνομιλία."
