    "Finds references to conversation images for available image analysis or editing tools." : {
      "comment" : "Description of the list image attachments built-in tool.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Finds references to conversation images for available image analysis or editing tools.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Hittar referenser till konversationsbilder för tillgängliga verktyg för bildanalys eller bildredigering.",
