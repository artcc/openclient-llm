            "value" : "Controla a aleatoriedade. Valores mais altos tornam a saída mais criativa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la casualità. Valori più alti rendono l'output più creativo."
          }
