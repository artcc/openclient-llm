    "Customizing any option replaces the global settings for this chat. Reset all options to use global settings." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "value" : "La personalizzazione di qualsiasi opzione sostituisce le impostazioni globali per questa chat. Reimposta tutte le opzioni per utilizzare le impostazioni globali.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Η προσαρμογή οποιασδήποτε επιλογής αντικαθιστά τις καθολικές ρυθμίσεις για αυτήν τη συνομιλία. Επαναφέρετε όλες τις επιλογές για να χρησιμοποιήσετε τις καθολικές ρυθμίσεις.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La personnalisation d’une option remplace les réglages globaux pour cette conversation. Réinitialisez toutes les options pour utiliser les réglages globaux."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Personalizar qualquer opção substitui as definições globais deste chat. Reponha todas as opções para utilizar as definições globais.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du anpassar något alternativ ersätter det de globala inställningarna för den här chatten. Återställ alla alternativ för att använda de globala inställningarna."
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Customizing any option replaces the global settings for this chat. Reset all options to use global settings.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Anpassen einer Option ersetzt die globalen Einstellungen für diesen Chat. Setze alle Optionen zurück, um die globalen Einstellungen zu verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Personalizar cualquier opción reemplaza los ajustes globales de este chat. Restablece todas las opciones para usar los ajustes globales.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "オプションをカスタマイズすると、このチャットのグローバル設定が置き換えられます。すべてのオプションをリセットしてグローバル設定を使用します。",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Het aanpassen van een optie overschrijft de algemene instellingen voor deze chat. Stel alle opties opnieuw in om de algemene instellingen te gebruiken.",
            "state" : "translated"
          }
        }
      }
    },
