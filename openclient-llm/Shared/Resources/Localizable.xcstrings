    "Compatible selected models may be called automatically when the chat model needs help with images." : {
      "comment" : "A description of how image and vision models can be used with the chat model.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Compatible selected models may be called automatically when the chat model needs help with images.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Los modelos seleccionados compatibles pueden activarse automáticamente cuando el modelo de chat necesite ayuda con imágenes.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Compatibele geselecteerde modellen kunnen automatisch worden aangeroepen wanneer het chatmodel hulp nodig heeft bij afbeeldingen.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Kompatible ausgewählte Modelle können automatisch aufgerufen werden, wenn das Chatmodell Hilfe bei Bildern benötigt.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompatibla valda modeller kan anropas automatiskt när chattmodellen behöver hjälp med bilder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains modèles sélectionnés compatibles peuvent être appelés automatiquement lorsque le modèle de chat a besoin d’aide avec les images."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "互換性のある選択済みモデルは、チャットモデルが画像の処理に支援を必要とすると自動的に呼び出されることがあります。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I modelli selezionati compatibili possono essere chiamati automaticamente quando il modello di chat ha bisogno di aiuto con le immagini."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os modelos selecionados compatíveis podem ser chamados automaticamente quando o modelo de chat precisar de ajuda com imagens."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα συμβατά επιλεγμένα μοντέλα μπορεί να καλούνται αυτόματα όταν το μοντέλο συνομιλίας χρειάζεται βοήθεια με εικόνες."
          }
        }
      }
    },
