    "Finds references to images attached to the conversation for image analysis. Requires a selected vision model when the chat model cannot see images." : {
      "comment" : "Tool description.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "value" : "画像分析のために会話に添付された画像への参照を検索します。チャットモデルが画像を認識できない場合は、ビジョンモデルを選択する必要があります。",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Εντοπίζει αναφορές σε εικόνες που έχουν επισυναφθεί στη συνομιλία για ανάλυση εικόνας. Απαιτείται επιλεγμένο μοντέλο όρασης όταν το μοντέλο συνομιλίας δεν μπορεί να δει εικόνες.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Recherche les références aux images jointes à la conversation pour l’analyse d’images. Nécessite un modèle de vision sélectionné lorsque le modèle de chat ne peut pas voir les images.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Findet Verweise auf an die Unterhaltung angehängte Bilder zur Bildanalyse. Erfordert ein ausgewähltes Bildverarbeitungsmodell, wenn das Chatmodell keine Bilder sehen kann.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Vindt verwijzingen naar afbeeldingen die aan het gesprek zijn toegevoegd voor beeldanalyse. Vereist een geselecteerd visiemodel wanneer het chatmodel geen afbeeldingen kan zien.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Hittar referenser till bilder som bifogats i konversationen för bildanalys. Kräver att en synmodell har valts när chattmodellen inte kan se bilder.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Busca referencias a imágenes adjuntas a la conversación para analizarlas. Requiere un modelo de visión seleccionado cuando el modelo de chat no puede ver imágenes.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Trova i riferimenti alle immagini allegate alla conversazione per l’analisi delle immagini. Richiede un modello di visione selezionato quando il modello di chat non può vedere le immagini.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Finds references to images attached to the conversation for image analysis. Requires a selected vision model when the chat model cannot see images.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Encontra referências a imagens anexadas à conversa para análise de imagens. Requer um modelo de visão selecionado quando o modelo de conversação não consegue ver imagens.",
            "state" : "translated"
          }
        }
      }
    },
