          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Start a new chat or search your conversations",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Beginnen Sie einen neuen Chat oder durchsuchen Sie Ihre Unterhaltungen.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Avvia una nuova chat o cerca nelle tue conversazioni.",
