          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Se eliminarán todas las configuraciones y credenciales locales. Los datos de iCloud no se verán afectados.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "All local settings and credentials will be deleted. iCloud data will not be affected.",
