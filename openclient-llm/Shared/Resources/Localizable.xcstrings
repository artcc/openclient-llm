    "Removes saved memories when you ask to forget them. Unavailable in Private Chat." : {
      "comment" : "Description of a built-in tool that removes saved memories when the user asks to forget them.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "value" : "忘れるよう依頼された保存済みの記憶を削除します。プライベートチャットでは利用できません。",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Αφαιρεί τις αποθηκευμένες μνήμες όταν ζητάτε να τις ξεχάσει. Δεν είναι διαθέσιμο στη Ιδιωτική συνομιλία.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Supprime les souvenirs enregistrés lorsque vous demandez leur oubli. Indisponible dans les conversations privées.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Entfernt gespeicherte Erinnerungen, wenn du darum bittest, sie zu vergessen. Im privaten Chat nicht verfügbar.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Verwijdert opgeslagen herinneringen wanneer je vraagt ze te vergeten. Niet beschikbaar in Privéchats.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Tar bort sparade minnen när du ber om att de ska glömmas. Inte tillgängligt i privat chatt.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Elimina los recuerdos guardados cuando pides olvidarlos. No disponible en el chat privado.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Rimuove i ricordi salvati quando chiedi di dimenticarli. Non disponibile nella chat privata.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Removes saved memories when you ask to forget them. Unavailable in Private Chat.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Remove memórias guardadas quando pede para as esquecer. Indisponível no Chat privado.",
            "state" : "translated"
          }
        }
      }
    },
