    "Tap + to create your first custom prompt template." : {
      "comment" : "A description of the action to create a custom prompt template.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf +, um deine erste benutzerdefinierte Eingabevorlage zu erstellen."
