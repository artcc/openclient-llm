          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した画像生成モデルで会話画像を1枚編集します。画像認識に対応した専用画像モデルと、ネイティブ画像生成に対応していないチャットモデルが必要です。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Redigerar en konversationsbild med den valda bildgenereringsmodellen. Kräver en särskild bildmodell med synförmåga och en chattmodell utan inbyggd bildgenerering.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Edita una imagen de una conversación con el modelo de generación de imágenes seleccionado. Requiere un modelo de imágenes especializado con visión y un modelo de chat sin generación de imágenes nativa.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Edita uma imagem da conversa com o modelo de geração de imagens selecionado. Requer um modelo de imagens dedicado com visão e um modelo de chat sem geração de imagens nativa.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Modifica un’immagine della conversazione con il modello di generazione delle immagini selezionato. Richiede un modello di immagini dedicato con capacità visive e un modello di chat senza generazione nativa di immagini.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Modifie une image de conversation avec le modèle de génération d’images sélectionné. Nécessite un modèle d’image dédié doté de capacités de vision et un modèle conversationnel sans génération d’images native.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Bearbeitet ein Konversationsbild mit dem ausgewählten Bildgenerierungsmodell. Erfordert ein dediziertes Bildmodell mit Bilderkennung und ein Chatmodell ohne native Bildgenerierung.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Bewerkt één gespreksafbeelding met het door jou geselecteerde beeldgeneratiemodel. Hiervoor is een speciaal beeldmodel met visuele mogelijkheden en een chatmodel zonder ingebouwde beeldgeneratie vereist.",
