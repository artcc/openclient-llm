    "Your local profile and iCloud profile have different content with the same revision. Which profile would you like to keep?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "value" : "ローカルプロフィールとiCloudプロフィールの内容が同じリビジョンで異なります。どちらのプロフィールを残しますか？",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Το τοπικό προφίλ και το προφίλ iCloud έχουν διαφορετικό περιεχόμενο με την ίδια αναθεώρηση. Ποιο προφίλ θέλετε να διατηρήσετε;",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Votre profil local et votre profil iCloud contiennent des données différentes avec la même révision. Quel profil souhaitez-vous conserver ?",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Ihr lokales Profil und Ihr iCloud-Profil enthalten bei derselben Revision unterschiedliche Inhalte. Welches Profil möchten Sie behalten?",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Din lokala profil och din iCloud-profil har olika innehåll med samma revision. Vilken profil vill du behålla?",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Je lokale profiel en je iCloud-profiel bevatten verschillende gegevens met dezelfde revisie. Welk profiel wil je behouden?",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Tu perfil local y tu perfil de iCloud tienen contenido diferente con la misma revisión. ¿Qué perfil quieres conservar?",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Il tuo profilo locale e il profilo iCloud hanno contenuti diversi con la stessa revisione. Quale profilo vuoi mantenere?",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Your local profile and iCloud profile have different content with the same revision. Which profile would you like to keep?",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "O seu perfil local e o perfil do iCloud têm conteúdos diferentes com a mesma revisão. Que perfil pretende manter?",
            "state" : "translated"
          }
        }
      }
    },
    "This model advertises image generation, but its mode has no supported image generation transport." : {
      "comment" : "A warning displayed when an image generation model is selected but the image generation transport is not supported.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "value" : "このモデルは画像生成を宣伝していますが、そのモードでは対応する画像生成の通信方式がありません。",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Αυτό το μοντέλο διαφημίζει τη δημιουργία εικόνων, αλλά η λειτουργία του δεν υποστηρίζει τη μεταφορά για δημιουργία εικόνων.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Dieses Modell wirbt mit Bildgenerierung, aber sein Modus unterstützt keinen Transport für die Bildgenerierung.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Ce modèle annonce la génération d’images, mais son mode ne prend en charge aucun moyen de transport pour la génération d’images.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Este modelo anuncia la generación de imágenes, pero su modo no tiene ningún transporte compatible con la generación de imágenes.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Dit model biedt beeldgeneratie aan, maar de modus ervan ondersteunt geen transport voor beeldgeneratie.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Den här modellen marknadsför bildgenerering, men dess läge har inget transportprotokoll som stöder bildgenerering.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Questo modello dichiara di supportare la generazione di immagini, ma la sua modalità non supporta alcun protocollo di trasporto per la generazione di immagini.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "This model advertises image generation, but its mode has no supported image generation transport.",
