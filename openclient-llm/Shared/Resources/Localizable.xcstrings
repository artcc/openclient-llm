    "%lld of 1 MCP tool enabled. Availability and permissions can also be managed from the chat input bar." : {
      "comment" : "A summary of the number of MCP tools that are enabled.",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "value" : "%lld van 1 MCP-tool ingeschakeld. Beschikbaarheid en machtigingen kunnen ook worden beheerd via de invoerbalk van de chat.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "%lld av 1 MCP-verktyg aktiverat. Tillgänglighet och behörigheter kan också hanteras från chattens inmatningsfält.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "%lld de 1 herramienta MCP activada. La disponibilidad y los permisos también se pueden gestionar desde la barra de entrada del chat.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "%lld de 1 ferramenta MCP ativada. A disponibilidade e as permissões também podem ser geridas a partir da barra de introdução de texto do chat.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "%lld of 1 MCP tool enabled. Availability and permissions can also be managed from the chat input bar.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "%lld von 1 MCP-Tool aktiviert. Verfügbarkeit und Berechtigungen können auch über die Chat-Eingabeleiste verwaltet werden.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "%lld di 1 strumento MCP abilitato. Disponibilità e autorizzazioni possono essere gestite anche dalla barra di inserimento della chat.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "1 個中 %lld 個の MCP ツールが有効です。利用可能状況と権限はチャット入力バーからも管理できます。",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "%lld outil MCP sur 1 est activé. La disponibilité et les autorisations peuvent également être gérées depuis la barre de saisie du chat.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "%lld από 1 εργαλείο MCP ενεργοποιήθηκε. Η διαθεσιμότητα και τα δικαιώματα μπορούν επίσης να διαχειριστούν από τη γραμμή εισαγωγής συνομιλίας.",
            "state" : "translated"
          }
        }
      }
    },
    "This model advertises image generation, but its mode has no supported image generation transport." : {
      "comment" : "A warning displayed when an image generation model is selected but the image generation transport is not supported.",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "value" : "Dit model biedt beeldgeneratie aan, maar de modus ervan ondersteunt geen transport voor beeldgeneratie.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Den här modellen marknadsför bildgenerering, men dess läge har inget transportprotokoll som stöder bildgenerering.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Este modelo anuncia la generación de imágenes, pero su modo no tiene ningún transporte compatible con la generación de imágenes.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Este modelo anuncia geração de imagens, mas o respetivo modo não tem nenhum método de transporte de geração de imagens suportado.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "This model advertises image generation, but its mode has no supported image generation transport.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Dieses Modell wirbt mit Bildgenerierung, aber sein Modus unterstützt keinen Transport für die Bildgenerierung.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Questo modello dichiara di supportare la generazione di immagini, ma la sua modalità non supporta alcun protocollo di trasporto per la generazione di immagini.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Αυτό το μοντέλο διαφημίζει τη δημιουργία εικόνων, αλλά η λειτουργία του δεν υποστηρίζει τη μεταφορά για δημιουργία εικόνων.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "このモデルは画像生成を宣伝していますが、そのモードでは対応する画像生成の通信方式がありません。",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Ce modèle annonce la génération d’images, mais son mode ne prend en charge aucun moyen de transport pour la génération d’images.",
            "state" : "translated"
          }
        }
      }
    },
    "Choose which OpenClient tools the assistant can use. Tools require a model that supports tool calling. Image tools may make additional model requests." : {
      "comment" : "A description of the built-in tools section.",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies welke OpenClient-tools de assistent kan gebruiken. Voor tools is een model vereist dat toolaanroepen ondersteunt. Afbeeldingstools kunnen extra modelaanvragen genereren."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vilka OpenClient-verktyg assistenten kan använda. Verktyg kräver en modell som stöder verktygsanrop. Bildverktyg kan medföra ytterligare modellförfrågningar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué herramientas de OpenClient puede usar el asistente. Las herramientas requieren un modelo compatible con la llamada a herramientas. Las herramientas de imagen pueden realizar solicitudes adicionales al modelo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha as ferramentas do OpenClient que o assistente pode utilizar. As ferramentas requerem um modelo compatível com chamadas de ferramentas. As ferramentas de imagem podem efetuar pedidos adicionais ao modelo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which OpenClient tools the assistant can use. Tools require a model that supports tool calling. Image tools may make additional model requests."
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Wählen Sie aus, welche OpenClient-Tools der Assistent verwenden kann. Für Tools ist ein Modell erforderlich, das Tool-Aufrufe unterstützt. Bild-Tools können zusätzliche Modellanfragen stellen.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Scegli quali strumenti di OpenClient può utilizzare l’assistente. Gli strumenti richiedono un modello che supporti le chiamate agli strumenti. Gli strumenti per le immagini possono effettuare richieste aggiuntive al modello.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アシスタントが使用できるOpenClientツールを選択してください。ツールを使用するには、ツール呼び出しに対応したモデルが必要です。画像ツールでは、追加のモデルリクエストが発生する場合があります。"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε ποια εργαλεία του OpenClient μπορεί να χρησιμοποιεί ο βοηθός. Τα εργαλεία απαιτούν μοντέλο που υποστηρίζει κλήσεις εργαλείων. Τα εργαλεία εικόνας ενδέχεται να πραγματοποιούν επιπλέον αιτήματα προς το μοντέλο."
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Choisissez les outils OpenClient que l’assistant peut utiliser. Les outils nécessitent un modèle prenant en charge les appels d’outils. Les outils d’image peuvent entraîner des requêtes supplémentaires au modèle.",
            "state" : "translated"
          }
        }
      }
    },
