    "Each prepared image must be a supported, nonempty image of at most 5 MB." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε προετοιμασμένη εικόνα πρέπει να είναι υποστηριζόμενη, μη κενή και να έχει μέγεθος έως 5 MB."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Elke voorbereide afbeelding moet een ondersteunde, niet-lege afbeelding van maximaal 5 MB zijn.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje förberedd bild måste vara en bild som stöds, vara icke-tom och vara högst 5 MB stor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada imagen preparada debe ser una imagen compatible, no estar vacía y tener un tamaño máximo de 5 MB."
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Ogni immagine preparata deve essere un'immagine supportata e non vuota di dimensioni massime pari a 5 MB.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "準備した各画像は、対応形式の空でない画像で、サイズが最大5 MBである必要があります。",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque image préparée doit être une image prise en charge et non vide d’au plus 5 Mo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada imagem preparada tem de ser uma imagem suportada e não vazia, com um máximo de 5 MB."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes vorbereitete Bild muss ein unterstütztes, nicht leeres Bild mit maximal 5 MB sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each prepared image must be a supported, nonempty image of at most 5 MB."
          }
        }
      }
    },
    "These tools are unavailable until this server refreshes successfully." : {
      "comment" : "A warning message that appears when the MCP server is unavailable.",
      "localizations" : {
        "el" : {
          "stringUnit" : {
