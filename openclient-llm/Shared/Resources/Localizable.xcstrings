            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "MCPツールを読み込めませんでした。サーバー接続を確認して、もう一度お試しください。",
            "state" : "translated"
          }
        }
      }
    },
