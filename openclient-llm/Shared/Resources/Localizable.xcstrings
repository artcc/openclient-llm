    "This external tool may access, create, change, or delete data and may incur costs." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "value" : "Cet outil externe peut accéder à vos données, en créer, les modifier ou les supprimer, et peut entraîner des frais.",
