    "Searches the web for current information. Requires a configured search service and web search enabled in the chat." : {
      "comment" : "Description of the web search tool.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Searches the web for current information. Requires a configured search service and web search enabled in the chat.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoekt op het web naar actuele informatie. Vereist een geconfigureerde zoekservice en ingeschakeld zoeken op het web in de chat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca informazioni aggiornate sul web. Richiede un servizio di ricerca configurato e la ricerca sul web abilitata nella chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca información actual en la web. Requiere un servicio de búsqueda configurado y la búsqueda web habilitada en el chat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söker på webben efter aktuell information. Kräver en konfigurerad söktjänst och att webbsökning är aktiverad i chatten."
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "最新情報をウェブで検索します。設定済みの検索サービスと、チャットでのウェブ検索の有効化が必要です。",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναζητά στον ιστό τρέχουσες πληροφορίες. Απαιτεί ρυθμισμένη υπηρεσία αναζήτησης και ενεργοποιημένη αναζήτηση στον ιστό στη συνομιλία."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquisa na web informações atuais. Requer um serviço de pesquisa configurado e a pesquisa na web ativada na conversa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
