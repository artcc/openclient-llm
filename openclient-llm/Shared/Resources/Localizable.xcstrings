          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the app from Shortcuts, other apps, or a browser using `openclient:\/\/`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l’application depuis Raccourcis, d’autres applications ou un navigateur en utilisant `openclient:\/\/`."
