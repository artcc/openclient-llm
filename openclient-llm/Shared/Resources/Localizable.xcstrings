    "Only one image generation or editing request is allowed per turn. Do not retry." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Only one image generation or editing request is allowed per turn. Do not retry.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per beurt is slechts één verzoek voor het genereren of bewerken van een afbeelding toegestaan. Probeer het niet opnieuw."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È consentita una sola richiesta di generazione o modifica di immagini per turno. Non riprovare."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast en begäran om bildgenerering eller bildredigering är tillåten per tur. Försök inte igen."
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Solo se permite una solicitud de generación o edición de imágenes por turno. No vuelvas a intentarlo.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "1回のターンにつき、画像の生成または編集リクエストは1件のみ許可されています。再試行しないでください。",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule demande de génération ou de modification d’image est autorisée par tour. Ne réessayez pas."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιτρέπεται μόνο ένα αίτημα δημιουργίας ή επεξεργασίας εικόνας ανά γύρο. Μην επαναλάβετε την προσπάθεια."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro Durchgang ist nur eine Anfrage zur Bildgenerierung oder -bearbeitung zulässig. Nicht erneut versuchen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só é permitido um pedido de geração ou edição de imagem por turno. Não tente novamente."
          }
        }
      }
    },
