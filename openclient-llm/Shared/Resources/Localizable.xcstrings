    "This image request cannot be regenerated with the selected model. Start a new message and attach any image needed." : {
      "comment" : "Error message displayed when the user tries to regenerate an image with a model that doesn't support it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "This image request cannot be regenerated with the selected model. Start a new message and attach any image needed.",
