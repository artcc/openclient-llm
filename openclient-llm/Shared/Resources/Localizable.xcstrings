          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前を入力してください"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Ange ditt namn",
            "state" : "translated"
