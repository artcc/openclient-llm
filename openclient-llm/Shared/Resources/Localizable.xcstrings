    "Tap the message actions button to edit, regenerate, branch, or save it as a favourite." : {
      "comment" : "A description of the message actions button.",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton d’actions du message pour le modifier, le régénérer, créer une branche ou l’enregistrer comme favori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca il pulsante delle azioni del messaggio per modificarlo, rigenerarlo, creare un ramo o salvarlo tra i preferiti."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πατήστε το κουμπί ενεργειών μηνύματος για να το επεξεργαστείτε, να το αναδημιουργήσετε, να δημιουργήσετε κλάδο ή να το αποθηκεύσετε ως αγαπημένο."
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Toca el botón de acciones del mensaje para editarlo, regenerarlo, crear una bifurcación o guardarlo como favorito.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Toque no botão de ações da mensagem para a editar, regenerar, criar uma ramificação ou guardá-la como favorita.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
