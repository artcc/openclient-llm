      }
    },
    "This image request cannot be regenerated with the selected model. Start a new message and attach any image needed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "value" : "Esta solicitud de imagen no se puede regenerar con el modelo seleccionado. Inicia un mensaje nuevo y adjunta las imágenes necesarias.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este pedido de imagem não pode ser regenerado com o modelo selecionado. Inicie uma nova mensagem e anexe as imagens necessárias."
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Diese Bildanfrage kann mit dem ausgewählten Modell nicht erneut generiert werden. Starten Sie eine neue Nachricht und hängen Sie alle benötigten Bilder an.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したモデルではこの画像リクエストを再生成できません。新しいメッセージを開始し、必要な画像を添付してください。"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här bildförfrågan kan inte genereras igen med den valda modellen. Starta ett nytt meddelande och bifoga de bilder som behövs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Cette demande d’image ne peut pas être régénérée avec le modèle sélectionné. Commencez un nouveau message et joignez les images nécessaires.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Αυτό το αίτημα εικόνας δεν μπορεί να αναδημιουργηθεί με το επιλεγμένο μοντέλο. Ξεκινήστε νέο μήνυμα και επισυνάψτε τυχόν εικόνα που χρειάζεται.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Questa richiesta di immagine non può essere rigenerata con il modello selezionato. Inizia un nuovo messaggio e allega le immagini necessarie.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Dit afbeeldingsverzoek kan niet opnieuw worden gegenereerd met het geselecteerde model. Start een nieuw bericht en voeg de benodigde afbeelding toe.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "This image request cannot be regenerated with the selected model. Start a new message and attach any image needed.",
            "state" : "translated"
          }
        }
      },
      "comment" : "Error message displayed when the user tries to regenerate an image with a model that doesn't support it."
    },
    "An attached image could not be loaded. Please attach it again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "value" : "Impossibile caricare un’immagine allegata. Allegala di nuovo.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Een bijgevoegde afbeelding kon niet worden geladen. Voeg de afbeelding opnieuw toe.",
            "state" : "translated"
          }
        },
        "el" : {
