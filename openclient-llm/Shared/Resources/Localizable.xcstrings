    "Try again to save your server settings, or go back to review them." : {
      "comment" : "A message that appears when the server configuration wasn't saved.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Try again to save your server settings, or go back to review them.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "サーバー設定の保存をもう一度試すか、戻って設定を確認してください。",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försök spara serverinställningarna igen eller gå tillbaka för att granska dem."
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Intenta guardar de nuevo la configuración de tu servidor o vuelve atrás para revisarla.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Tente guardar novamente as definições do servidor ou volte atrás para as rever.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Prova di nuovo a salvare le impostazioni del server oppure torna indietro per rivederle.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Réessayez d’enregistrer les paramètres de votre serveur ou revenez en arrière pour les vérifier.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Versuchen Sie, Ihre Servereinstellungen erneut zu speichern, oder gehen Sie zurück, um sie zu überprüfen.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Probeer je serverinstellingen opnieuw op te slaan of ga terug om ze te controleren.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Προσπαθήστε ξανά να αποθηκεύσετε τις ρυθμίσεις του διακομιστή σας ή επιστρέψτε για να τις ελέγξετε.",
            "state" : "translated"
          }
        }
      }
    },
    "The conversation summary cursor does not reference one of its messages." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "The conversation summary cursor does not reference one of its messages.",
            "state" : "translated"
          }
