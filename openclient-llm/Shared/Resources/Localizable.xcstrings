    "This image analysis request exceeds the vision model's context window. Reduce the number of images, shorten the question, or choose a vision model with a larger context window." : {
      "comment" : "A message that can be displayed to the user when the image analysis request is too large.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "value" : "Diese Bildanalyseanfrage überschreitet das Kontextfenster des Vision-Modells. Reduzieren Sie die Anzahl der Bilder, kürzen Sie die Frage oder wählen Sie ein Vision-Modell mit einem größeren Kontextfenster.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verzoek voor beeldanalyse overschrijdt het contextvenster van het visiemodel. Verminder het aantal afbeeldingen, verkort de vraag of kies een visiemodel met een groter contextvenster."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa richiesta di analisi delle immagini supera la finestra di contesto del modello di visione. Riduci il numero di immagini, accorcia la domanda oppure scegli un modello di visione con una finestra di contesto più ampia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Den här bildanalysbegäran överskrider kontextfönstret för synmodellen. Minska antalet bilder, korta ned frågan eller välj en synmodell med ett större kontextfönster.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Esta solicitud de análisis de imágenes supera la ventana de contexto del modelo de visión. Reduce el número de imágenes, acorta la pregunta o elige un modelo de visión con una ventana de contexto más amplia.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この画像分析リクエストはビジョンモデルのコンテキストウィンドウを超えています。画像の数を減らすか、質問を短くするか、より大きなコンテキストに対応したビジョンモデルを選択してください。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande d’analyse d’image dépasse la fenêtre de contexte du modèle de vision. Réduisez le nombre d’images, raccourcissez la question ou choisissez un modèle de vision doté d’une fenêtre de contexte plus large."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este pedido de análise de imagens excede a janela de contexto do modelo de visão. Reduza o número de imagens, encurte a pergunta ou escolha um modelo de visão com uma janela de contexto maior."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το αίτημα ανάλυσης εικόνων υπερβαίνει το όριο περιεχομένου του μοντέλου όρασης. Μειώστε τον αριθμό των εικόνων, συντομεύστε την ερώτηση ή επιλέξτε ένα μοντέλο όρασης με μεγαλύτερο όριο περιεχομένου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This image analysis request exceeds the vision model's context window. Reduce the number of images, shorten the question, or choose a vision model with a larger context window."
          }
        }
      }
    },
    "The memory change could not be saved. Please try again." : {
      "comment" : "Error message displayed when an error occurs while saving a memory change.",
      "localizations" : {
        "el" : {
