    "If your server does not detect capabilities correctly, turn off automatic detection to choose vision, tools, or image generation manually. Save your choices with Done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "value" : "Wenn dein Server die Funktionen nicht korrekt erkennt, deaktiviere die automatische Erkennung, um Vision, Tools oder Bildgenerierung manuell auszuwählen. Speichere deine Auswahl mit „Fertig“.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your server does not detect capabilities correctly, turn off automatic detection to choose vision, tools, or image generation manually. Save your choices with Done."
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Si votre serveur ne détecte pas correctement les fonctionnalités, désactivez la détection automatique pour choisir manuellement la vision, les outils ou la génération d’images. Enregistrez vos choix avec Terminé.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu servidor no detecta correctamente las capacidades, desactiva la detección automática para elegir manualmente visión, herramientas o generación de imágenes. Guarda tus selecciones con «Listo»."
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Se il tuo server non rileva correttamente le funzionalità, disattiva il rilevamento automatico per scegliere manualmente visione, strumenti o generazione di immagini. Salva le tue scelte con Fine.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Als je server de mogelijkheden niet correct detecteert, schakel automatische detectie uit om vision, tools of het genereren van afbeeldingen handmatig te kiezen. Sla je keuzes op met ‘Gereed’.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om din server inte identifierar funktionerna korrekt kan du stänga av automatisk identifiering för att välja vision, verktyg eller bildgenerering manuellt. Spara dina val genom att trycka på Klar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o seu servidor não detetar corretamente as capacidades, desative a deteção automática para escolher manualmente visão, ferramentas ou geração de imagens. Guarde as suas escolhas com Concluído."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αν ο διακομιστής σας δεν εντοπίζει σωστά τις δυνατότητες, απενεργοποιήστε τον αυτόματο εντοπισμό για να επιλέξετε χειροκίνητα την όραση, τα εργαλεία ή τη δημιουργία εικόνων. Αποθηκεύστε τις επιλογές σας πατώντας «Τέλος»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが機能を正しく検出しない場合は、自動検出をオフにして、ビジョン、ツール、画像生成を手動で選択してください。「完了」で選択内容を保存します。"
          }
        }
      }
    },
