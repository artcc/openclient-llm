    "Chats in “%@”: %lld. Deleting this folder keeps the chats in Unfiled." : {
      "localizations" : {
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversas em “%1$@”: %2$lld. A eliminação desta pasta mantém as conversas em Não arquivadas."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats in „%1$@“: %2$lld. Durch das Löschen dieses Ordners bleiben die Chats unter „Nicht abgelegt“ erhalten."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chattar i ”%1$@”: %2$lld. Om du raderar den här mappen finns chattarna kvar i Ej arkiverade."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat in “%1$@”: %2$lld. L’eliminazione di questa cartella mantiene le chat in Non archiviati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats in ‘%1$@’: %2$lld. Als je deze map verwijdert, blijven de chats in Ongeordend staan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」内のチャット：%2$lld件。このフォルダを削除しても、チャットは未分類に残ります。"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνομιλίες στο «%1$@»: %2$lld. Η διαγραφή αυτού του φακέλου διατηρεί τις συνομιλίες στα «Χωρίς φάκελο»."
