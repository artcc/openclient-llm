          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η επεξεργασία χρησιμοποιεί ένα ειδικό μοντέλο εικόνας με όραση και επεξεργάζεται μία εικόνα της συνομιλίας ανά γύρο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La edición utiliza un modelo de imágenes especializado con visión y edita una imagen de la conversación por turno."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editing uses a dedicated image model with vision and edits one conversation image per turn."
          }
        },
        "fr" : {
          "stringUnit" : {
