    "Your support keeps development and updates going!" : {
      "comment" : "A description of the benefits of supporting OpenClient.",
      "localizations" : {
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O seu apoio permite dar continuidade ao desenvolvimento e às atualizações!"
          }
        },
        "it" : {
