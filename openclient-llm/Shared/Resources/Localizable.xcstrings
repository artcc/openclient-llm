    "Uses your selected image generation model to create an image when the chat model cannot generate one itself." : {
      "comment" : "Tool description.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "value" : "チャットモデルが自力で画像を生成できない場合に、選択した画像生成モデルを使って画像を作成します。",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Χρησιμοποιεί το επιλεγμένο μοντέλο δημιουργίας εικόνων για να δημιουργήσει μια εικόνα όταν το μοντέλο συνομιλίας δεν μπορεί να δημιουργήσει εικόνα από μόνο του.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Utilise votre modèle de génération d’images sélectionné pour créer une image lorsque le modèle de chat ne peut pas en générer une lui-même.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Verwendet dein ausgewähltes Bildgenerierungsmodell, um ein Bild zu erstellen, wenn das Chatmodell selbst keines generieren kann.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Gebruikt je geselecteerde beeldgeneratiemodel om een afbeelding te maken wanneer het chatmodel dit niet zelf kan.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Usa tu modelo seleccionado de generación de imágenes para crear una imagen cuando el modelo de chat no pueda generarla por sí mismo.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Använder din valda bildgenereringsmodell för att skapa en bild när chattmodellen inte kan generera en själv.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Utilizza il modello di generazione delle immagini selezionato per creare un’immagine quando il modello di chat non è in grado di generarne una autonomamente.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Utiliza o modelo de geração de imagens selecionado para criar uma imagem quando o modelo de chat não consegue gerar uma por si próprio.",
            "state" : "translated"
          }
        },
        "en" : {
          "stringUnit" : {
            "value" : "Uses your selected image generation model to create an image when the chat model cannot generate one itself.",
            "state" : "translated"
          }
        }
      }
    },
