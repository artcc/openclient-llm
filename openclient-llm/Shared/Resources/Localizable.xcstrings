    "OpenClient automatically sends each chat's identifier in this header. Each chat has a different identifier that stays the same when you reopen it. It is not sent when listing models or testing the connection." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "OpenClient automatically sends each chat's identifier in this header. Each chat has a different identifier that stays the same when you reopen it. It is not sent when listing models or testing the connection.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O OpenClient envia automaticamente o identificador de cada conversa neste cabeçalho. Cada conversa tem um identificador diferente, que permanece o mesmo quando a reabre. Não é enviado ao listar modelos ou ao testar a ligação."
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Το OpenClient στέλνει αυτόματα το αναγνωριστικό κάθε συνομιλίας σε αυτήν την κεφαλίδα. Κάθε συνομιλία έχει διαφορετικό αναγνωριστικό, το οποίο παραμένει ίδιο όταν την ανοίγετε ξανά. Δεν αποστέλλεται κατά την καταχώριση μοντέλων ή τον έλεγχο της σύνδεσης.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "OpenClientはこのヘッダーで各チャットの識別子を自動的に送信します。チャットごとに異なる識別子が割り当てられ、再度開いても同じ識別子が使用されます。モデルの一覧表示時や接続テスト時には送信されません。",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient skickar automatiskt varje chats identifierare i denna header. Varje chatt har en unik identifierare som förblir densamma när du öppnar den igen. Den skickas inte när modeller listas eller anslutningen testas."
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "OpenClient invia automaticamente l'identificatore di ogni chat in questo header. Ogni chat ha un identificatore diverso che rimane invariato quando la riapri. Non viene inviato quando elenchi i modelli o verifichi la connessione.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient envoie automatiquement l’identifiant de chaque conversation dans cet en-tête. Chaque conversation possède un identifiant différent qui reste le même lorsque vous la rouvrez. Il n’est pas envoyé lors de la liste des modèles ou du test de la connexion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient envía automáticamente el identificador de cada chat en este encabezado. Cada chat tiene un identificador diferente que permanece igual al volver a abrirlo. No se envía al enumerar modelos ni al probar la conexión."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient sendet die Kennung jedes Chats automatisch in diesem Header. Jeder Chat hat eine andere Kennung, die beim erneuten Öffnen unverändert bleibt. Sie wird beim Auflisten der Modelle oder beim Testen der Verbindung nicht gesendet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "OpenClient verstuurt automatisch de identifier van elke chat in deze header. Elke chat heeft een andere identifier die hetzelfde blijft wanneer je de chat opnieuw opent. Deze wordt niet verzonden bij het weergeven van modellen of het testen van de verbinding.",
            "state" : "translated"
          }
        }
      }
    },
