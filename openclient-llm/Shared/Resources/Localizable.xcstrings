    "Editing uses a dedicated image model with vision and edits one conversation image per turn." : {
      "comment" : "A description of how the editing feature works.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Editing uses a dedicated image model with vision and edits one conversation image per turn.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "編集では視覚機能を備えた専用の画像モデルを使用し、1回のターンにつき会話内の画像を1枚編集します。",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Redigering använder en dedikerad bildmodell med bildförståelse och redigerar en samtalsbild per tur.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "La edición utiliza un modelo de imágenes especializado con visión y edita una imagen de la conversación por turno.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A edição utiliza um modelo de imagem dedicado com visão e edita uma imagem da conversa por turno."
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "La modifica utilizza un modello di immagini dedicato con capacità visive e modifica un'immagine della conversazione per turno.",
