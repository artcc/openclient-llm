    "Use the message actions button to edit, regenerate, branch, or save it as a favourite." : {
      "comment" : "A tip that explains how to use the message actions button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "value" : "Use the message actions button to edit, regenerate, branch, or save it as a favourite.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "メッセージのアクションボタンを使って、編集、再生成、分岐、またはお気に入りへの保存を行えます。",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Använd knappen för meddelandeåtgärder för att redigera, generera om, skapa en förgrening eller spara det som en favorit.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Usa el botón de acciones del mensaje para editarlo, regenerarlo, crear una ramificación o guardarlo como favorito.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Utilize o botão de ações da mensagem para a editar, gerar novamente, criar uma ramificação ou guardá-la como favorita.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Usa il pulsante delle azioni del messaggio per modificarlo, rigenerarlo, creare un ramo o salvarlo tra i preferiti.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Utilisez le bouton d’actions du message pour le modifier, le régénérer, créer une branche ou l’enregistrer dans vos favoris.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Verwende die Nachrichtentaste, um sie zu bearbeiten, neu zu generieren, einen Zweig zu erstellen oder als Favorit zu speichern.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Gebruik de knop voor berichtacties om het bericht te bewerken, opnieuw te genereren, een vertakking te maken of het als favoriet op te slaan.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε το κουμπί ενεργειών μηνύματος για να το επεξεργαστείτε, να το αναδημιουργήσετε, να δημιουργήσετε διακλάδωση ή να το αποθηκεύσετε ως αγαπημένο."
          }
        }
      }
    },
    "Review, edit, disable, or delete the memories used in future conversations." : {
      "comment" : "A description of the memory management feature.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review, edit, disable, or delete the memories used in future conversations"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "今後の会話で使用される記憶を確認、編集、無効化、または削除します。",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Granska, redigera, inaktivera eller ta bort minnen som används i framtida konversationer.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Revisa, edita, desactiva o elimina los recuerdos usados en futuras conversaciones.",
            "state" : "translated"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Revise, edite, desative ou elimine as memórias usadas em conversas futuras.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Rivedi, modifica, disabilita o elimina i ricordi utilizzati nelle conversazioni future.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Révisez, modifiez, désactivez ou supprimez les souvenirs utilisés dans les conversations futures.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Überprüfen, bearbeiten, deaktivieren oder löschen Sie die Erinnerungen, die in zukünftigen Gesprächen verwendet werden.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Beoordeel, bewerk, schakel uit of verwijder de herinneringen die in toekomstige gesprekken worden gebruikt.",
            "state" : "translated"
          }
        },
        "el" : {
          "stringUnit" : {
            "value" : "Αναθεώρηση, επεξεργασία, απενεργοποίηση ή διαγραφή των αναμνήσεων που χρησιμοποιούνται σε μελλοντικές συνομιλίες.",
            "state" : "translated"
          }
        }
      }
    },
