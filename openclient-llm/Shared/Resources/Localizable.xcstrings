    "Header names must be unique, regardless of capitalization." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "value" : "I nomi delle intestazioni devono essere univoci, indipendentemente dall'uso delle maiuscole e delle minuscole.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "value" : "Kopnamenamen moeten uniek zijn, ongeacht hoofdlettergebruik.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Les noms d’en-tête doivent être uniques, quelle que soit la casse.",
            "state" : "translated"
          }
        },
        "ja" : {
          "stringUnit" : {
            "value" : "ヘッダー名は、大文字と小文字の違いにかかわらず一意でなければなりません。",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres de encabezado deben ser únicos, independientemente de las mayúsculas y minúsculas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Header names must be unique, regardless of capitalization."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Headernamen müssen unabhängig von der Groß- und Kleinschreibung eindeutig sein."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "value" : "Os nomes dos cabeçalhos têm de ser únicos, independentemente das maiúsculas e minúsculas.",
            "state" : "translated"
          }
        },
