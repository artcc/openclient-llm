    "Chat image generation currently supports text prompts only." : {
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η δημιουργία εικόνων μέσω συνομιλίας υποστηρίζει προς το παρόν μόνο προτροπές κειμένου."
          }
        },
