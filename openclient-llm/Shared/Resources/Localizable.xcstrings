    "Searches the web for current information. Requires a configured search service and web search enabled in the chat." : {
      "comment" : "Description of the web search tool.",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "value" : "Zoekt op het web naar actuele informatie. Vereist een geconfigureerde zoekservice en ingeschakeld zoeken op het web in de chat.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Söker på webben efter aktuell information. Kräver en konfigurerad söktjänst och att webbsökning är aktiverad i chatten.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Busca información actual en la web. Requiere un servicio de búsqueda configurado y la búsqueda web habilitada en el chat.",
